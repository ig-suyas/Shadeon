# Copy to .env.local and fill in what you have. Every value is optional in
# development: without them the forms use a local embedded database, print
# waitlist emails to the server console, and skip the human check.
# Never commit .env.local.

# Public site origin, used in export headers, install commands and emails.
NEXT_PUBLIC_SITE_URL=https://shadeon.dev

# Postgres (Neon). Required in production for the waitlist, request and contact forms.
# DATABASE_URL is what the site uses: in production, the restricted shadeon_app role
# from scripts/db-app-role.sql, never the owner.
# DATABASE_MIGRATION_URL is the owner, used only by `npm run db:migrate` on your machine;
# do not set it on the deployed site.
DATABASE_URL=
DATABASE_MIGRATION_URL=

# Upstash Redis (REST) for rate limits shared across server instances. Required for
# launch: without it each serverless instance counts on its own.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Any random string of 16+ characters. Keeps hashed rate-limit keys stable across restarts.
RATE_LIMIT_SALT=

# Cloudflare Turnstile. Set both or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend, for account (sign-up, password reset) and waitlist emails. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# Any random string of 16+ characters. Vercel Cron sends it to /api/cron/purge,
# the daily job that deletes data past its retention period.
CRON_SECRET=

# Google sign-in ("Continue with Google"). The client id is public by design; no
# client secret is used. In Google Cloud Console, add these authorised redirect URIs:
#   https://<your domain>/auth/google/callback   and, for development,
#   http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=

# 32+ random characters. Signs the one-hour shadcn install links for signed-in visitors.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
